# Copia questo file in ".env" e compila i valori.
# Il file ".env" e' escluso dal versionamento.

TPLINK_HOST=192.168.0.1
TPLINK_PASSWORD=la_tua_password_admin

# Soglia percentuale sotto la quale notificare
BATTERY_THRESHOLD=20

# Minuti tra un controllo e l'altro
CHECK_INTERVAL_MINUTES=5

# Minuti minimi tra due notifiche consecutive di batteria bassa
NOTIFY_COOLDOWN_MINUTES=60

# Mostra i GB accanto all'icona nel pannello (1=si, 0=no)
SHOW_DATA_IN_PANEL=1

# Mostra la percentuale batteria accanto all'icona (1=si, 0=no)
SHOW_BATTERY_IN_PANEL=1

# Percorso opzionale del file di stato
# TP_BATTERY_STATE=~/.cache/tplink-battery-monitor/state.json
